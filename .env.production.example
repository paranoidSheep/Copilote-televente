# Copier en .env sur le VPS, compléter, puis : docker compose up -d --build
# Ne JAMAIS versionner le fichier .env (il contient des secrets).

# Nom de domaine pointant vers le VPS (enregistrement DNS A/AAAA) et e-mail pour Let's Encrypt
DOMAINE=copilote.mon-entreprise.fr
EMAIL_ACME=admin@mon-entreprise.fr

# Secret de signature des sessions (64 caractères aléatoires) :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Données : mock (démonstration) ou http (vrai datahub)
DATASOURCE=mock
# DATAHUB_URL=https://datahub.mon-entreprise.local/api/v1
# DATAHUB_TOKEN=

# IA : auto = Claude si une clé est définie, sinon IA simulée
LLM_MODE=auto
ANTHROPIC_API_KEY=
# Latence simulée pour une démo réaliste (millisecondes)
LLM_LATENCE_SIMULEE_MS=400

# Documentation interactive de l'API (/docs) : à désactiver si non nécessaire
DOCUMENTATION_API=non
DUREE_SESSION_HEURES=12
