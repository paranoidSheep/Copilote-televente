# Copier en .env sur le VPS, compléter, puis : docker compose up -d --build
# Ne JAMAIS versionner le fichier .env (il contient des secrets).

# Nom de domaine pointant vers le VPS (enregistrement DNS A/AAAA) et e-mail pour Let's Encrypt
DOMAINE=copilote.mon-entreprise.fr
EMAIL_ACME=admin@mon-entreprise.fr

# Secret de signature des sessions (64 caractères aléatoires) :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Données : mock (démonstration) ou http (vrai datahub)
DATASOURCE=mock
# DATAHUB_URL=https://datahub.mon-entreprise.local/api/v1
# DATAHUB_TOKEN=
# DATAHUB_TIMEOUT=10
# Pour tester le chemin http avec le simulateur (docker compose --profile simulateur up -d) :
# DATASOURCE=http
# DATAHUB_URL=http://datahub-simulateur:8100
# DATAHUB_TOKEN=un-jeton-au-choix
# DATAHUB_DATE_REFERENCE=2026-10-23
# SIMULATEUR_OPTIONS=--anomalies

# IA : auto | anthropic | mistral | openai | gemini | compatible | simule | repli
#   auto = le premier fournisseur configuré (dans l'ordre ci-dessous), sinon IA simulée
LLM_MODE=auto

# Fournisseurs d'IA : renseigner ceux qu'on veut utiliser (plusieurs possibles, comparables dans le Labo).
# Détail et variables facultatives ({PREFIXE}_BASE_URL, _PRIX_ENTREE, _PRIX_SORTIE, _MAX_TOKENS) : README,
# section « Choisir son fournisseur d'IA ».
#
# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# Mistral AI (modèle obligatoire, ex. mistral-medium-latest : voir docs.mistral.ai)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# MISTRAL_PRIX_ENTREE=        # dollars par million de jetons, pour le coût estimé du banc d'évaluation
# MISTRAL_PRIX_SORTIE=
#
# OpenAI (modèle obligatoire : voir la documentation OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# Gemini, via son point d'accès compatible OpenAI (modèle obligatoire : voir ai.google.dev)
# GEMINI_API_KEY=
# GEMINI_MODEL=
#
# Tout service compatible OpenAI : Ollama, vLLM, LM Studio, OpenRouter…
# Modèle local avec le service Ollama facultatif (docker compose --profile ollama up -d) :
# LLM_COMPATIBLE_BASE_URL=http://ollama:11434/v1
# LLM_COMPATIBLE_MODEL=qwen3
# LLM_COMPATIBLE_NOM=Ollama
# LLM_COMPATIBLE_API_KEY=     # seulement si le service en demande une
# Latence simulée pour une démo réaliste (millisecondes)
LLM_LATENCE_SIMULEE_MS=400

# Documentation interactive de l'API (/docs) : à désactiver si non nécessaire
DOCUMENTATION_API=non
DUREE_SESSION_HEURES=12
