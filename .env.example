# Copier en .env puis charger avec : set -a; source .env; set +a

# Source de données : mock (données simulées) ou http (vrai datahub)
DATASOURCE=mock

# IA : sans clé, l'application fonctionne en mode repli (fiche rédigée sans LLM)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Vrai datahub (uniquement si DATASOURCE=http)
DATAHUB_URL=
DATAHUB_TOKEN=
# DATAHUB_TIMEOUT=10
