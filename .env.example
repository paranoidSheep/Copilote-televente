# Copier en .env puis charger avec : set -a; source .env; set +a

# Source de données : mock (données simulées) ou http (vrai datahub)
DATASOURCE=mock

# Rédacteur des fiches : auto | anthropic | mistral | openai | gemini | compatible | simule | repli
#   auto = le premier fournisseur configuré (dans l'ordre ci-dessous), sinon IA simulée
LLM_MODE=auto

# Fournisseurs d'IA : renseigner ceux qu'on veut utiliser (plusieurs possibles, comparables dans le Labo).
# Détail et variables facultatives ({PREFIXE}_BASE_URL, _PRIX_ENTREE, _PRIX_SORTIE, _MAX_TOKENS) : README,
# section « Choisir son fournisseur d'IA ».
#
# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# Mistral AI (modèle obligatoire, ex. mistral-medium-latest : voir docs.mistral.ai)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# MISTRAL_PRIX_ENTREE=        # dollars par million de jetons, pour le coût estimé du banc d'évaluation
# MISTRAL_PRIX_SORTIE=
#
# OpenAI (modèle obligatoire : voir la documentation OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# Gemini, via son point d'accès compatible OpenAI (modèle obligatoire : voir ai.google.dev)
# GEMINI_API_KEY=
# GEMINI_MODEL=
#
# Tout service compatible OpenAI : Ollama, vLLM, LM Studio, OpenRouter…
# LLM_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# LLM_COMPATIBLE_MODEL=qwen3
# LLM_COMPATIBLE_NOM=Ollama
# LLM_COMPATIBLE_API_KEY=     # seulement si le service en demande une
# Latence ajoutée à l'IA simulée, pour une démo réaliste (millisecondes)
# LLM_LATENCE_SIMULEE_MS=400

# Journal local des comptes-rendus d'appels (SQLite, jamais l'ERP)
# JOURNAL_PATH=var/journal.sqlite3

# Vrai datahub (uniquement si DATASOURCE=http)
DATAHUB_URL=
DATAHUB_TOKEN=
# DATAHUB_TIMEOUT=10
# Durée de cache des données du datahub (secondes)
# CACHE_SECONDES=300
