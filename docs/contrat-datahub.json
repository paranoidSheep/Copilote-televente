{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrat d'interface du datahub (copilote télévente)",
    "description": "Ressources que le datahub doit exposer au copilote, EN LECTURE SEULE. Authentification : en-tête `Authorization: Bearer <jeton>`. Pagination : paramètres `page` (à partir de 1) et `taille`, réponse `{items, next}`. Erreurs : 401 si le jeton est absent ou invalide, 404 si la ressource n'existe pas.",
    "version": "1.0"
  },
  "paths": {
    "/clients": {
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "Clients",
        "description": "Clients actifs, avec le télévendeur en charge (champ `commercial`).",
        "operationId": "clients_clients_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Numéro de page, à partir de 1",
              "default": 1,
              "title": "Page"
            },
            "description": "Numéro de page, à partir de 1"
          },
          {
            "name": "taille",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Nombre d'éléments par page",
              "default": 200,
              "title": "Taille"
            },
            "description": "Nombre d'éléments par page"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageClients"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clients/{client_id}": {
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "Client",
        "description": "Un client ; 404 s'il n'existe pas.",
        "operationId": "client_clients__client_id__get",
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Client Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/commandes": {
      "get": {
        "tags": [
          "commandes"
        ],
        "summary": "Commandes",
        "description": "Historique des commandes, lignes comprises (le copilote lit environ 6 mois).",
        "operationId": "commandes_commandes_get",
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restreint aux commandes de ce client",
              "title": "Client Id"
            },
            "description": "Restreint aux commandes de ce client"
          },
          {
            "name": "depuis",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Date de début incluse (AAAA-MM-JJ)",
              "title": "Depuis"
            },
            "description": "Date de début incluse (AAAA-MM-JJ)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Numéro de page, à partir de 1",
              "default": 1,
              "title": "Page"
            },
            "description": "Numéro de page, à partir de 1"
          },
          {
            "name": "taille",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Nombre d'éléments par page",
              "default": 200,
              "title": "Taille"
            },
            "description": "Nombre d'éléments par page"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageCommandes"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/produits": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "Produits",
        "description": "Catalogue : prix tarif HT, famille (frais / surgelé) et durée de vie typique.",
        "operationId": "produits_produits_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Numéro de page, à partir de 1",
              "default": 1,
              "title": "Page"
            },
            "description": "Numéro de page, à partir de 1"
          },
          {
            "name": "taille",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Nombre d'éléments par page",
              "default": 200,
              "title": "Taille"
            },
            "description": "Nombre d'éléments par page"
          },
          {
            "name": "authorization",
            "in": "header",
