            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stock/lots": {
      "get": {
        "tags": [
          "stock"
        ],
        "summary": "Lots",
        "description": "Stock DISPONIBLE à la vente, par lot avec sa DLC (hors stock réservé ou bloqué).",
        "operationId": "lots_stock_lots_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Numéro de page, à partir de 1",
              "default": 1,
              "title": "Page"
            },
            "description": "Numéro de page, à partir de 1"
          },
          {
            "name": "taille",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Nombre d'éléments par page",
              "default": 200,
              "title": "Taille"
            },
            "description": "Nombre d'éléments par page"
          },
          {
            "name": "authorization",
            "in": "header",
